{
  "name": "sansho-carnival",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "assets:ogp": "node scripts/generate-ogp.mjs",
    "test:production": "TEST_URL=http://127.0.0.1:4173 node scripts/browser-test.mjs",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "build:pages": "npm run build:standalone && node scripts/build-pages.mjs",
    "test:pages": "TEST_URL=http://127.0.0.1:4174/sansho/ node scripts/browser-test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
